# Portable Blender install and its download (not part of the toolkit)
blender-*/
blender-*.tar.xz

# Python / Blender caches and backups
__pycache__/
*.pyc
*.blend1
backups/

# User assets and generated output (keep the folder structure only)
Meshy-Blender-Toolkit/assets/*/*
Meshy-Blender-Toolkit/work/*
Meshy-Blender-Toolkit/output/*
Meshy-Blender-Toolkit/reports/*
!Meshy-Blender-Toolkit/assets/*/.gitkeep
!Meshy-Blender-Toolkit/work/.gitkeep
!Meshy-Blender-Toolkit/output/.gitkeep
!Meshy-Blender-Toolkit/reports/.gitkeep
