# Portable Blender install and its download (not part of the toolkit)
blender-*/
blender-*.tar.xz

# Python / Blender caches and backups
__pycache__/
*.pyc
*.blend1
backups/

# The Mixamo clip library (~1 GB of FBX) is too heavy for git; keep it local.
Meshy-Blender-Toolkit/assets/animations/Mixamo/

# Fingerprint cache for scripts/find_skinless_clips.py (rebuilt from the library)
Meshy-Blender-Toolkit/cache/

# Over GitHub's 100 MB file limit; rebuilt by scripts/build_pixelover_glb.py
Meshy-Blender-Toolkit/work/Kitsune_KK_animated.blend
Meshy-Blender-Toolkit/work/Kitsune_KK_ready.blend
